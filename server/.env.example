# GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
#
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

HOST=127.0.0.1
PORT=3000
